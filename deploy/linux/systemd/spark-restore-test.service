[Unit]
Description=Spark - test de restauration du dernier dump dans un Postgres jetable
Documentation=https://github.com/spark-kit/spark-kit
Requires=docker.service
After=docker.service spark-compose.service

[Service]
Type=oneshot
User=spark
Group=spark
WorkingDirectory=/opt/spark/infra
# Pause de maintenance : `touch /opt/spark/MAINTENANCE` (une seule garde, ExecCondition : « skipped »
# dans le journal, sans etat failed).
ExecCondition=/usr/bin/test ! -f /opt/spark/MAINTENANCE
ExecStart=/opt/spark/infra/scripts/restore-test.sh
TimeoutStartSec=1800
Nice=10
