# =============================================================
#  Spark .env — source unique (macOS et Linux)
#  Ne pas editer ce fichier a la main pour un site : utiliser
#    deploy/scripts/init-env.sh --prefix <prefix> --domain <domain> <infra>/.env
#  qui copie ce gabarit et genere les secrets (alphabet URL-safe A-Za-z0-9).
#  Toute variable lue par deploy/compose.yml figure ici (test : docker compose config
#  avec ce fichier renomme en .env ne doit signaler aucune variable manquante).
#  chmod 600 .env apres creation.
#  Priorite : pour docker compose comme pour les scripts du kit (backup.sh, restore-test.sh),
#  une variable DEJA posee dans l'environnement (ligne de commande, Environment= d'une unit
#  systemd) l'emporte sur ce fichier, y compris sur une ligne vide « NOM= ». Ce fichier fait
#  foi pour tout ce qui n'est pas pose dans l'environnement.
#  Verifier les valeurs obligatoires sans les afficher : deploy/scripts/check-env.sh (ne regarde
#  que le fichier, jamais l'environnement du shell).
#  Ce fichier est SOURCE COMME DU SHELL par les scripts du kit : une valeur qui contient $, un
#  accent grave ou une espace va entre guillemets simples, ex. NOM='val eur'. Les secrets generes
#  par init-env.sh (A-Za-z0-9) n'en ont pas besoin.
# =============================================================

# --- Site -------------------------------------------------------
# Slug de l'instance, forme les hostnames <prefix>-<service>.<domain>
SPARK_PREFIX=acme
SPARK_DOMAIN=acme.example
# Port hote sur lequel Caddy ecoute (127.0.0.1 uniquement)
SPARK_HOST_HTTP_PORT=18080
# Fuseau horaire de n8n (GENERIC_TIMEZONE et TZ)
SPARK_TZ=Europe/Paris

# --- Profils compose (lus par docker compose, separes par des virgules) --------------------
# Vide a l'installation. `tunnel` est pose a l'etape 4 des guides (cloudflared en conteneur) ;
# `runners` seulement apres le banc du sidecar (UPGRADES.md), avec COMPOSE_FILE ci-dessous.
COMPOSE_PROFILES=
# Sidecar runner n8n : decommenter pour que `docker compose` (et l'unit systemd) lisent aussi
# l'override qui bascule n8n en mode externe. Sans cette ligne, compose.yml seul.
#COMPOSE_FILE=compose.yml:compose.runners.yml

# --- PostgreSQL (lus par init-db.sh au premier demarrage) ------
POSTGRES_ROOT_PASSWORD=
N8N_DB_PASSWORD=
NOCODB_DB_PASSWORD=
# Plafond memoire du conteneur Postgres (format docker : 512m, 1g)
PG_MEM_LIMIT=512m

# --- n8n (openssl rand -hex 32 ; sans cette cle, les identifiants
#     n8n d'une sauvegarde restauree sont illisibles) -----------
N8N_ENCRYPTION_KEY=
# Memoire : N8N_HEAP_MB + N8N_RUNNERS_HEAP_MB + ~200 Mo <= N8N_MEM_LIMIT (runner interne dans le
# meme cgroup). Serveur 8 Go : 1g / 640 / 192 ; stack chargee : 1536m / 1024 / 256.
N8N_MEM_LIMIT=1g
N8N_HEAP_MB=640
N8N_RUNNERS_HEAP_MB=192
# Sauts de proxy devant n8n : 2 = Cloudflare -> cloudflared -> Caddy (chemin du kit). Voir le
# commentaire de compose.yml ; ne pas changer sans relire la mesure d'UPGRADES.md.
N8N_PROXY_HOPS=2
# Sidecar runner (profil runners + compose.runners.yml) : jeton partage n8n <-> runner (genere par
# init-env.sh, utilise seulement en mode externe) et plafond memoire du sidecar.
N8N_RUNNERS_AUTH_TOKEN=
N8N_RUNNERS_MEM_LIMIT=512m

# --- NocoDB (openssl rand -hex 32) -----------------------------
NC_AUTH_JWT_SECRET=

# --- Caddy ------------------------------------------------------
CADDY_MEM_LIMIT=128m

# --- Cloudflare Tunnel (remplir a l'etape 4 du guide) ----------
SPARK_TUNNEL_ID=
# Repertoire des identifiants du tunnel (<id>.json, config.yml), monte en lecture seule dans le
# conteneur cloudflared. Linux : /opt/spark/.cloudflared ; macOS : /Users/<compte>/.cloudflared
# (chemin absolu, docker compose ne developpe pas ~ ni $HOME ici).
SPARK_TUNNEL_DIR=
# Utilisateur hote sous lequel tourne le conteneur cloudflared (proprietaire de SPARK_TUNNEL_DIR) :
# poses par init-env.sh (id -u / id -g du compte qui installe).
SPARK_UID=
SPARK_GID=
# Port hote (127.0.0.1) des metriques cloudflared : /ready, /metrics
SPARK_TUNNEL_METRICS_PORT=2000
# Variante « cloudflared sur l'hote » (unit systemd / LaunchAgent) : fichier de config genere par
# tunnel-config.sh --host. Inutilise avec le profil tunnel.
SPARK_TUNNEL_CONFIG=
CF_API_TOKEN=
CF_ZONE_ID=

# --- Sauvegardes (deploy/scripts/backup.sh) --------------------
# Cle publique age du destinataire des archives de secrets (.env, config n8n).
# La cle PRIVEE reste hors de la machine. Generer : age-keygen -o spark-backup.key
BACKUP_AGE_RECIPIENT=
# Variante sans age : fichier de passphrase pour gpg --symmetric (chmod 600)
BACKUP_GPG_PASSPHRASE_FILE=
# Retention locale des dumps et tars, en jours
BACKUP_KEEP_DAYS=14
# Webhook appele sur echec de backup.sh / restore-test.sh : POST JSON {host, script, message,
# error (derniere ligne ERREUR, sans secret), ts, status}. Vide = alerte sur stderr seulement
# (journal systemd). Peut aussi etre pose par Environment= dans l'unit (il l'emporte alors).
SPARK_ALERT_WEBHOOK=
# restore-test.sh : 0 = une base sans identifiant n8n donne un avertissement et reussit (installation
# neuve) ; 1 = elle fait echouer le test. Passer a 1 en production des qu'un identifiant n8n existe.
RESTORE_TEST_REQUIRE_CREDENTIAL=0

# --- MCP / outillage agent (remplir apres premier acces) -------
N8N_API_KEY=
NOCODB_API_TOKEN=
